#!/usr/bin/env python3
"""Render actual hunting plus a camera inspection of the same live cutout rigs."""
import argparse
import os
from pathlib import Path
import subprocess
import tempfile
from render_rune_stone import display_server, ROOT

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--godot',required=True)
    parser.add_argument('--output',type=Path,required=True)
    parser.add_argument('--display')
    parser.add_argument('--xorg-config',type=Path)
    parser.add_argument('--review-only',action='store_true',help='Render labelled enlarged poses without recording the hunting movie.')
    args=parser.parse_args()
    args.output=args.output.resolve();args.output.mkdir(parents=True,exist_ok=True)
    captures=args.output/'captures';captures.mkdir(exist_ok=True)
    env=os.environ.copy()
    with tempfile.TemporaryDirectory(prefix='hunt-action-pilot-') as tmp:
        for name,folder in [('XDG_DATA_HOME','data'),('XDG_CONFIG_HOME','config'),('XDG_CACHE_HOME','cache'),('APPDATA','appdata'),('MAP_CAPTURE_USER_DATA','saves'),('PILOT_MOVIE_FRAMES','frames')]:
            path=Path(tmp)/folder;path.mkdir();env[name]=str(path)
        env['MAP_CAPTURE_OUTPUT']=str(captures)
        with display_server(args,env):
            command=[args.godot,'--path',str(ROOT),'--rendering-method','mobile','--audio-driver','Dummy','--disable-vsync','--script','tools/review_hunt_pilot.gd' if args.review_only else 'tools/capture_hunt_action_pilot.gd']
            if args.display:command+=['--display-driver','x11']
            log_path=args.output/('anatomy-render.log' if args.review_only else 'render.log')
            with log_path.open('w') as log:
                subprocess.run(command,env=env,stdout=log,stderr=subprocess.STDOUT,timeout=300,check=True)
            log=log_path.read_text()
            marker='HUNT_PILOT_ANATOMY_REVIEW_OK' if args.review_only else 'HUNT_ACTION_PILOT_CAPTURE_OK'
            if any(mark in log for mark in ['ERROR:','SCRIPT ERROR','SHADER ERROR']) or marker not in log:
                raise RuntimeError('Render failed: '+str(log_path))
        if args.review_only:
            print('HUNT_PILOT_ANATOMY_REVIEW_OK '+str(captures));return
        subprocess.run(['ffmpeg','-hide_banner','-loglevel','error','-y','-framerate','30','-i',str(Path(env['PILOT_MOVIE_FRAMES'])/'frame-%04d.png'),'-c:v','libx264','-crf','19','-pix_fmt','yuv420p','-movflags','+faststart',str(captures/'live-hunting.mp4')],check=True)
        print('HUNT_ACTION_PILOT_RENDER_OK '+str(captures))
if __name__=='__main__':main()
