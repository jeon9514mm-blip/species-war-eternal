extends SceneTree
## Enlarged assembly inspection, explicitly separate from the live hunting movie.
const PILOT=preload('res://scripts/art/HuntPilotRig3D.gd')
const CLOCK=preload('res://scripts/art/HuntPilotTimeline.gd')
var output: String
var game: Node
var viewport: SubViewport
var camera: Camera3D
var hero_rig: Node3D
var enemy_rig: Node3D
var label: Label
func _init() -> void:run.call_deferred()
func settle() -> void:
	for i in 3:await process_frame
func frame(name: String,hero_time: float,enemy_time: float,action: String,flip:=false) -> void:
	hero_rig.source.flip_h=flip;enemy_rig.source.flip_h=flip
	hero_rig._current_pose.clear();enemy_rig._current_pose.clear()
	hero_rig.pilot_sample={'action':action,'time':hero_time,'duration':.15/.44,'sequence':1}
	enemy_rig.pilot_sample={'action':action,'time':enemy_time,'duration':.22/.44,'sequence':1}
	hero_rig.sync(camera,1.55,Color.WHITE,0,true)
	enemy_rig.sync(camera,1.20,Color.WHITE,0,true)
	label.text='관절 확대 검수 · '+name+'  /  별도 자세 시연'
	await settle();await RenderingServer.frame_post_draw
	assert(root.get_texture().get_image().save_png(output.path_join('anatomy-'+name+'.png'))==OK)
	var file:=FileAccess.open(output.path_join('anatomy-'+name+'.json'),FileAccess.WRITE)
	file.store_string(JSON.stringify({'not_live_hunting':true,'purpose':'full articulated pose and collar inspection','hero':hero_rig.debug_snapshot(),'goblin':enemy_rig.debug_snapshot()},'  '));file.close()
func run() -> void:
	if DisplayServer.get_name()=='headless':quit(1);return
	output=OS.get_environment('MAP_CAPTURE_OUTPUT');assert(not output.is_empty())
	root.content_scale_size=Vector2i(1280,720);root.size=Vector2i(1280,720)
	game=load('res://scenes/PortraitMain.tscn').instantiate()
	game.save_state_path=OS.get_environment('MAP_CAPTURE_USER_DATA').path_join('anatomy.json');game._offline_checked=true
	root.add_child(game);await settle();game.set_process(false);game.set_physics_process(false);game.sound_effects_enabled=false
	game.selected_faction='aurelia';game.idle_stage=1;game.current_zone_id='gray_meadow'
	var ids: Array[String]=['leonhardt'];game._restore_deployed_heroes(ids);game._build_combat_screen();await settle()
	game.combat_running=false;game.hide();game.combat_labels.terrain.set_process(false)
	var board:=SubViewportContainer.new();board.stretch=true;board.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT);root.add_child(board)
	viewport=SubViewport.new();viewport.own_world_3d=true;viewport.size=Vector2i(1280,720);viewport.render_target_update_mode=SubViewport.UPDATE_ALWAYS;viewport.msaa_3d=Viewport.MSAA_4X;board.add_child(viewport)
	var world:=Node3D.new();viewport.add_child(world)
	var environment_node:=WorldEnvironment.new();var env:=Environment.new();env.background_mode=Environment.BG_COLOR;env.background_color=Color('#182731');env.tonemap_mode=Environment.TONE_MAPPER_LINEAR;environment_node.environment=env;world.add_child(environment_node)
	camera=Camera3D.new();camera.projection=Camera3D.PROJECTION_ORTHOGONAL;camera.size=2.4;camera.current=true
	world.add_child(camera);camera.position=Vector3(0,2.1,6);camera.look_at(Vector3(0,.9,0))
	hero_rig=PILOT.new();world.add_child(hero_rig);assert(hero_rig.bind_pilot(game.hero_map_sprites[0],true));hero_rig.position=Vector3(-.65,.08,0)
	var source=game.enemy_wave_sprites[0];MonsterSpriteFactory.apply_casual(source,'초원 고블린',source.presentation_scale)
	enemy_rig=PILOT.new();world.add_child(enemy_rig);assert(enemy_rig.bind_pilot(source,false));enemy_rig.position=Vector3(.65,.08,0)
	for actor in [hero_rig.source,enemy_rig.source]:actor.set_process(false);actor.speed_scale=1.0
	label=Label.new();label.position=Vector2(36,24);label.add_theme_font_size_override('font_size',24);root.add_child(label)
	for sample in [['neutral',0.0,0.0,'idle'],['windup',.15/.44*.22,.22/.44*.22,'attack_1'],['impact',.15,.22,'attack_1'],['recovery',.15/.44*.74,.22/.44*.74,'attack_1'],['walk',.18,.18,'walk'],['death',.60,.60,'death']]:
		await frame(sample[0],sample[1],sample[2],sample[3])
	await frame('impact-mirrored',.15,.22,'attack_1',true)
	game.presentation_runtime.audio.shutdown();game.background_hunt.discard();game.queue_free();board.queue_free();label.queue_free();await settle()
	print('HUNT_PILOT_ANATOMY_REVIEW_OK');quit.call_deferred()
