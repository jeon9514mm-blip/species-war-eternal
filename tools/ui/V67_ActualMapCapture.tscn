[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_capture"]
script/source = "extends Node\n## Open this scene in the v67 project and press F6 in a graphical Godot editor.\n## Screenshots use the real PortraitMain viewport and a separate preview save.\nconst GAME := preload('res://scenes/PortraitMain.tscn')\nconst ZONES := ['gray_meadow', 'forgotten_mine', 'moonrest_forest']\nconst FILENAMES := ['01-meadow.png', '02-mine.png', '03-moonrest-forest.png']\n\nfunc _ready() -> void:\n\tif DisplayServer.get_name() == 'headless':\n\t\tpush_error('Actual screenshots require a graphical Godot window. Open this scene in the v67 project and press F6.')\n\t\tget_tree().quit(2)\n\t\treturn\n\tvar window: Window = get_tree().root\n\twindow.content_scale_size = Vector2i(720, 1280)\n\twindow.size = Vector2i(720, 1280)\n\tvar stamp: String = Time.get_datetime_string_from_system().replace(':', '-')\n\tvar folder: String = ProjectSettings.globalize_path('user://v67-map-captures-' + stamp)\n\tif DirAccess.make_dir_recursive_absolute(folder) != OK:\n\t\tpush_error('Could not create screenshot folder: ' + folder)\n\t\tget_tree().quit(1)\n\t\treturn\n\tvar main: Node = GAME.instantiate()\n\tmain.save_state_path = 'user://v67-capture-session-' + stamp + '.json'\n\tadd_child(main)\n\tawait get_tree().process_frame\n\tmain._offline_checked = true\n\tmain.tutorial_completed = true\n\tmain.selected_faction = 'aurelia'\n\tmain.idle_stage = 25\n\tmain.battle_speed = 1.0\n\tmain.gear_auto_equip = false\n\tvar roster: Array = main._hero_roster_for_faction()\n\tmain.deployed_heroes = roster.slice(0, 10)\n\tmain._setup_hero_progress(roster)\n\tfor hero: Dictionary in main.deployed_heroes:\n\t\tmain.hero_progress[str(hero['id'])] = {'level': 35, 'xp': 0}\n\tvar captures: Array[Dictionary] = []\n\tfor index: int in ZONES.size():\n\t\tmain.current_zone_id = ZONES[index]\n\t\tmain._build_combat_screen()\n\t\tawait get_tree().create_timer(4.0).timeout\n\t\tawait RenderingServer.frame_post_draw\n\t\tvar screenshot: Image = window.get_texture().get_image()\n\t\tif screenshot == null or screenshot.is_empty():\n\t\t\tpush_error('Godot returned an empty screenshot for ' + ZONES[index])\n\t\t\tget_tree().quit(1)\n\t\t\treturn\n\t\tvar path: String = folder.path_join(FILENAMES[index])\n\t\tvar result: Error = screenshot.save_png(path)\n\t\tif result != OK:\n\t\t\tpush_error('Could not save screenshot: ' + path)\n\t\t\tget_tree().quit(1)\n\t\t\treturn\n\t\tcaptures.append({'zone': ZONES[index], 'file': FILENAMES[index], 'width': screenshot.get_width(), 'height': screenshot.get_height()})\n\t\tprint('Saved actual Godot viewport: ', path)\n\tvar manifest: FileAccess = FileAccess.open(folder.path_join('capture-info.json'), FileAccess.WRITE)\n\tif manifest != null:\n\t\tmanifest.store_string(JSON.stringify({'source': 'Actual Godot PortraitMain viewport; no image composition', 'engine': Engine.get_version_info()['string'], 'display': DisplayServer.get_name(), 'fixture': 'Stage 25, level 35, ten heroes, separate preview save', 'captures': captures}, '\\t'))\n\t\tmanifest.close()\n\tprint('Three map screenshots saved to: ', folder)\n\tOS.shell_open(folder)\n\tmain.queue_free()\n\tawait get_tree().process_frame\n\tget_tree().quit()\n"

[node name="V67ActualMapCapture" type="Node"]
script = SubResource("GDScript_capture")
