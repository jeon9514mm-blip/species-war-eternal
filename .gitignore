# Godot-generated local cache (keep *.import and *.uid source metadata)
.godot/

# Python and OS caches
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# Local credentials and machine-specific settings
.env
.env.*
!.env.example
export_credentials.cfg
*.keystore
*.jks

# Local exports and editor metadata
/builds/
/exports/
/.idea/

# Reproducible raw frames; keep the small review MP4 and selected stills.
/checks/hero-rig/captures/frames/
/checks/combat-quality/motion/frames/

# Regenerable review output; selected PNG/MP4 and compact JSON remain reviewable.
/checks/**/*.log
/checks/**/*.log.*
/checks/**/*.old
/checks/**/*.txt
!/checks/**/README.txt
/checks/**/*.import
/checks/**/frames/
/checks/**/raw/
/checks/**/tmp/
/checks/**/*.avi
/checks/**/github-base-tree.json
/checks/**/github-integration-plan.json
/checks/**/github-publish-manifest.json
/docs/**/*.log
/docs/**/*.import
/.venv-ai/

# Unity caches and local builds; source scenes, packages and settings stay tracked.
/Unity/[Ll]ibrary/
/Unity/[Tt]emp/
/Unity/[Oo]bj/
/Unity/[Ll]ogs/
/Unity/[Uu]ser[Ss]ettings/
/Unity/[Bb]uilds/
/Unity/build/
/Unity/.utmp/
/Unity/.vs/
/Unity/*.csproj
/Unity/*.sln
/Unity/*.slnx
/Unity/*.pidb
/Unity/*.unityproj
/Unity/*.user
